DEEPSEEK_API_KEY=你的 DeepSeek API Key
BETTER_AUTH_SECRET=一段足够长的随机字符串
BETTER_AUTH_URL=http://127.0.0.1:3000

# 可选：服务端口，默认 3000
PORT=3000
# 可选：只有前后端分离部署时才需要，填前端的确切来源，同源部署请留空
# CORS_ORIGIN=http://127.0.0.1:5180

# 默认演示用户：启动时自动创建，登录页提供「一键登录」
# 生产或公网部署务必改成 false，或换掉下面这组凭据
DEMO_USER_ENABLED=true
DEMO_USER_NAME=演示用户
DEMO_USER_EMAIL=demo@genshin.local
DEMO_USER_PASSWORD=demo12345
# 可选：自定义 SQLite 文件位置，默认项目根目录 agent.sqlite
# DATABASE_PATH=./agent.sqlite
